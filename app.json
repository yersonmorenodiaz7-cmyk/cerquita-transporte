{
  "expo": {
    "name": "CERQUITA",
    "slug": "cerquita",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "CERQUITA necesita tus fotos para subir los documentos del conductor.",
          "cameraPermission": "CERQUITA necesita la cámara para fotografiar tus documentos."
        }
      ]
    ],
    "android": {
      "package": "co.cerquita.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCJE1yH0oFONZmj_AecTNLSEo9F7pOQTsQ"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1769ff"
      }
    },
    "ios": {
      "bundleIdentifier": "co.cerquita.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CERQUITA usa tu ubicación para conectar pasajeros y conductores cercanos."
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a4fe0"
    },
    "extra": {
      "eas": {
        "projectId": "6521e527-e080-4e9d-9e0e-b032f8eb536c"
      }
    },
    "owner": "19821974"
  }
}
